# ─── LINE Integration ───────────────────────────────────────────────────────
# Option A: LINE Notify (simpler — free service for individuals)
# Get your token at: https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# Option B: LINE Messaging API (for business accounts)
# Set both of these for the Messaging API to work:
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_GROUP_ID=your_group_or_user_id_here
